<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FileDownloadManager.UI.Resources.Localization"
        x:Class="FileDownloadManager.UI.MainWindow"
        Title="{x:Static loc:Strings.Title}" Width="640" Height="440"
        MinWidth="420" MinHeight="350" WindowStartupLocation="CenterScreen">
  <ScrollViewer>
    <StackPanel Margin="32" Spacing="18">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{x:Static loc:Strings.Heading}" FontSize="28" FontWeight="SemiBold" />
        <Button Grid.Column="1" Content="{x:Static loc:Strings.Exit}" Click="ExitClicked" />
      </Grid>
      <StackPanel x:Name="Fields" Spacing="16">
        <StackPanel Spacing="5">
          <TextBlock Classes="fieldLabel" Text="{x:Static loc:Strings.Url}" />
          <TextBox x:Name="SourceUrl" AutomationProperties.Name="{x:Static loc:Strings.Url}"
                   PlaceholderText="{x:Static loc:Strings.UrlHint}" />
        </StackPanel>
        <StackPanel Spacing="5">
          <TextBlock Classes="fieldLabel" Text="{x:Static loc:Strings.Destination}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="Destination" AutomationProperties.Name="{x:Static loc:Strings.Destination}"
                     PlaceholderText="{x:Static loc:Strings.DestinationHint}" />
            <Button Grid.Column="1" Content="{x:Static loc:Strings.Browse}" Click="BrowseClicked" />
          </Grid>
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="Start" Classes="accent" Content="{x:Static loc:Strings.Start}" Click="StartClicked" />
        <Button x:Name="Cancel" Content="{x:Static loc:Strings.Cancel}" IsVisible="False" Click="CancelClicked" />
      </StackPanel>
      <StackPanel Spacing="8">
        <ProgressBar x:Name="Activity" IsVisible="False" Height="4" />
        <TextBlock x:Name="Status" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
