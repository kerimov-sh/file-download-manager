<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FileDownloadManager.UI" xmlns:loc="using:FileDownloadManager.UI.Resources.Localization"
        FontSize="12" x:Class="FileDownloadManager.UI.MainWindow" Title="{x:Static loc:Strings.Title}"
        Width="960" Height="620" MinWidth="710" MinHeight="500" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu>
      <MenuItem Header="{x:Static loc:Strings.Tasks}">
        <MenuItem x:Name="AddMenu" Header="{x:Static loc:Strings.AddUrl}" Click="AddClicked" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Exit}" Click="ExitClicked" />
      </MenuItem>
      <MenuItem Header="{x:Static loc:Strings.Downloads}">
        <MenuItem x:Name="StopMenu" Header="{x:Static loc:Strings.StopTransfer}" Click="CancelClicked" IsEnabled="False" />
        <MenuItem x:Name="RemoveMenu" Header="{x:Static loc:Strings.RemoveEntry}" Click="RemoveClicked" IsEnabled="False" />
      </MenuItem>
      <MenuItem Header="{x:Static loc:Strings.View}">
        <MenuItem x:Name="SystemIcons" Header="{x:Static loc:Strings.SystemIcons}" ToggleType="Radio" GroupName="IconStyle" Click="SystemIconsClicked" />
        <MenuItem x:Name="BundledIcons" Header="{x:Static loc:Strings.BundledIcons}" ToggleType="Radio" GroupName="IconStyle" Click="BundledIconsClicked" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Options}" Click="OptionsClicked" />
      </MenuItem>
    </Menu>
    <Border Grid.Row="1" Classes="toolbar">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" x:Name="AddLinkButton" Click="AddClicked" AutomationProperties.Name="{x:Static loc:Strings.AddUrl}">
          <StackPanel Spacing="4">
            <PathIcon Width="28" Height="28" Foreground="{DynamicResource ToolbarAddBrush}" Data="{DynamicResource IconAddLink}" />
            <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.AddUrl}" />
          </StackPanel>
        </Button>
        <Button Classes="tool" x:Name="RetryButton" Click="RetryClicked" AutomationProperties.Name="{x:Static loc:Strings.Retry}" IsEnabled="False">
          <StackPanel Spacing="4">
            <PathIcon Width="28" Height="28" Foreground="{DynamicResource ToolbarRetryBrush}" Data="{DynamicResource IconActive}" />
            <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.Retry}" />
          </StackPanel>
        </Button>
        <Button Classes="tool" x:Name="StopButton" Click="CancelClicked" AutomationProperties.Name="{x:Static loc:Strings.StopTransfer}" IsEnabled="False">
          <StackPanel Spacing="4">
            <PathIcon Width="28" Height="28" Foreground="{DynamicResource ToolbarStopBrush}" Data="{DynamicResource IconStop}" />
            <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.StopTransfer}" />
          </StackPanel>
        </Button>
        <Button Classes="tool" x:Name="StopAllButton" Click="CancelClicked" AutomationProperties.Name="{x:Static loc:Strings.StopAll}" IsEnabled="False">
          <StackPanel Spacing="4">
            <PathIcon Width="28" Height="28" Foreground="{DynamicResource ToolbarStopAllBrush}" Data="{DynamicResource IconIncomplete}" />
            <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.StopAll}" />
          </StackPanel>
        </Button>
        <Button Classes="tool" x:Name="RemoveButton" Click="RemoveClicked" AutomationProperties.Name="{x:Static loc:Strings.RemoveEntry}" IsEnabled="False">
          <StackPanel Spacing="4">
            <PathIcon Width="28" Height="28" Foreground="{DynamicResource ToolbarRemoveBrush}" Data="{DynamicResource IconRemove}" />
            <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.RemoveEntry}" />
          </StackPanel>
        </Button>
        <Button Classes="tool" x:Name="ClearButton" Click="ClearFinishedClicked" AutomationProperties.Name="{x:Static loc:Strings.ClearFinished}" IsEnabled="False">
          <StackPanel Spacing="4">
            <PathIcon Width="28" Height="28" Foreground="{DynamicResource ToolbarClearBrush}" Data="{DynamicResource IconFinished}" />
            <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.ClearFinished}" />
          </StackPanel>
        </Button>
        <Button Classes="tool" x:Name="OptionsButton" Click="OptionsClicked" AutomationProperties.Name="{x:Static loc:Strings.Options}">
          <StackPanel Spacing="4">
            <PathIcon Width="28" Height="28" Foreground="{DynamicResource ToolbarOptionsBrush}" Data="{DynamicResource IconSettings}" />
            <TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.Options}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="168,*">
      <Border Classes="sidebar">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Margin="6,4" Text="{x:Static loc:Strings.Categories}" />
          <TreeView x:Name="Filters" SelectionChanged="FilterChanged">
            <TreeView.Styles>
              <Style Selector="TreeViewItem">
                <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Name}" />
                <Setter Property="IsExpanded" Value="True" />
                <Setter Property="MinHeight" Value="21" />
                <Setter Property="Padding" Value="0" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="ui:DownloadCategory" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <PathIcon Width="13" Height="13" Foreground="{DynamicResource CategoryIconBrush}" Data="{Binding Icon}" />
                  <TextBlock Text="{Binding Name}" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="columnHeader">
            <Grid ColumnDefinitions="2.3*,1*,1.1*,1*,1.2*,1.3*,1.5*">
              <Border Classes="cell" Grid.Column="0"><TextBlock Text="{x:Static loc:Strings.FileName}" TextTrimming="CharacterEllipsis" /></Border>
              <Border Classes="cell" Grid.Column="1"><TextBlock Text="{x:Static loc:Strings.FileSize}" TextTrimming="CharacterEllipsis" /></Border>
              <Border Classes="cell" Grid.Column="2"><TextBlock Text="{x:Static loc:Strings.TransferStatus}" TextTrimming="CharacterEllipsis" /></Border>
              <Border Classes="cell" Grid.Column="3"><TextBlock Text="{x:Static loc:Strings.TimeLeft}" TextTrimming="CharacterEllipsis" /></Border>
              <Border Classes="cell" Grid.Column="4"><TextBlock Text="{x:Static loc:Strings.Rate}" TextTrimming="CharacterEllipsis" /></Border>
              <Border Classes="cell" Grid.Column="5"><TextBlock Text="{x:Static loc:Strings.LastTry}" TextTrimming="CharacterEllipsis" /></Border>
              <Border Classes="cell" Grid.Column="6"><TextBlock Text="{x:Static loc:Strings.Description}" TextTrimming="CharacterEllipsis" /></Border>
            </Grid>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="2.3*,1*,1.1*,1*,1.2*,1.3*,1.5*" IsHitTestVisible="False">
            <Grid.Background>
              <DrawingBrush TileMode="Tile" DestinationRect="0,0,8,21" SourceRect="0,0,8,21" Stretch="Fill">
                <DrawingBrush.Drawing>
                  <DrawingGroup>
                    <GeometryDrawing Geometry="M0,0 H8 V21 H0 Z" Brush="Transparent" />
                    <GeometryDrawing Geometry="M0,20 H8 V21 H0 Z" Brush="{DynamicResource GridRule}" />
                  </DrawingGroup>
                </DrawingBrush.Drawing>
              </DrawingBrush>
            </Grid.Background>
            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GridRule}" />
            <Border Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GridRule}" />
            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GridRule}" />
            <Border Grid.Column="3" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GridRule}" />
            <Border Grid.Column="4" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GridRule}" />
            <Border Grid.Column="5" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GridRule}" />
            <Border Grid.Column="6" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource GridRule}" />
          </Grid>
          <ListBox Background="Transparent" Grid.Row="1" x:Name="Rows" SelectionChanged="RowChanged">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="21" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="ui:DownloadRow">
                <Grid ColumnDefinitions="2.3*,1*,1.1*,1*,1.2*,1.3*,1.5*">
                  <Border Classes="cell" Grid.Column="0"><Grid ColumnDefinitions="14,*" ColumnSpacing="3" ToolTip.Tip="{Binding Destination}"><PathIcon Width="12" Height="12" Data="{DynamicResource IconFile}" /><TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" /></Grid></Border>
                  <Border Classes="cell" Grid.Column="1"><Panel><TextBlock Text="{Binding Size}" IsVisible="{Binding !IsActive}" /><TextBlock Text="{Binding Metrics.Size}" IsVisible="{Binding IsActive}" /></Panel></Border>
                  <Border Classes="cell" Grid.Column="2"><Panel><TextBlock Text="{Binding Status}" IsVisible="{Binding !IsActive}" /><TextBlock Text="{Binding Metrics.Status}" IsVisible="{Binding IsActive}" /></Panel></Border>
                  <Border Classes="cell" Grid.Column="3"><TextBlock Text="{Binding Metrics.TimeLeft}" TextTrimming="CharacterEllipsis" /></Border>
                  <Border Classes="cell" Grid.Column="4"><TextBlock Text="{Binding Metrics.Rate}" TextTrimming="CharacterEllipsis" /></Border>
                  <Border Classes="cell" Grid.Column="5"><TextBlock Text="{Binding LastTry, StringFormat='{}{0:g}'}" TextTrimming="CharacterEllipsis" /></Border>
                  <Border Classes="cell" Grid.Column="6"><TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" /></Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Classes="footer">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <TextBlock x:Name="Status" Text="{x:Static loc:Strings.Ready}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <ProgressBar Grid.Column="1" x:Name="Activity" IsVisible="False" Width="65" Height="4" />
        <TextBlock Grid.Column="2" x:Name="Count" />
      </Grid>
    </Border>
  </Grid>
</Window>
