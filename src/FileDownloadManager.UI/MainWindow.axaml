<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FileDownloadManager.UI" xmlns:loc="using:FileDownloadManager.UI.Resources.Localization"
        x:Class="FileDownloadManager.UI.MainWindow" Title="{x:Static loc:Strings.Title}"
        Width="960" Height="620" MinWidth="710" MinHeight="500" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu>
      <MenuItem Header="{x:Static loc:Strings.Tasks}">
        <MenuItem x:Name="AddMenu" Header="{x:Static loc:Strings.AddUrl}" Click="AddClicked" />
        <Separator />
        <MenuItem Header="{x:Static loc:Strings.Exit}" Click="ExitClicked" />
      </MenuItem>
      <MenuItem Header="{x:Static loc:Strings.Downloads}">
        <MenuItem x:Name="StopMenu" Header="{x:Static loc:Strings.StopTransfer}" Click="CancelClicked" IsEnabled="False" />
        <MenuItem x:Name="RemoveMenu" Header="{x:Static loc:Strings.RemoveEntry}" Click="RemoveClicked" IsEnabled="False" />
      </MenuItem>
    </Menu>
    <Border Grid.Row="1" Classes="toolbar">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <Button Classes="tool" x:Name="AddLinkButton" Click="AddClicked" AutomationProperties.Name="{x:Static loc:Strings.AddUrl}">
          <StackPanel Spacing="4"><PathIcon Width="22" Height="22" Foreground="#3080C4" Data="{StaticResource IconAddLink}" /><TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.AddUrl}" /></StackPanel>
        </Button>
        <Button Classes="tool" x:Name="StopButton" Click="CancelClicked" AutomationProperties.Name="{x:Static loc:Strings.StopTransfer}" IsEnabled="False">
          <StackPanel Spacing="4"><PathIcon Width="22" Height="22" Foreground="#C65A4B" Data="{StaticResource IconStop}" /><TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.StopTransfer}" /></StackPanel>
        </Button>
        <Button Classes="tool" x:Name="RemoveButton" Click="RemoveClicked" AutomationProperties.Name="{x:Static loc:Strings.RemoveEntry}" IsEnabled="False">
          <StackPanel Spacing="4"><PathIcon Width="22" Height="22" Foreground="#778698" Data="{StaticResource IconRemove}" /><TextBlock HorizontalAlignment="Center" Text="{x:Static loc:Strings.RemoveEntry}" /></StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2" ColumnDefinitions="175,*">
      <Border Classes="sidebar">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Margin="14,12" Text="{x:Static loc:Strings.Categories}" />
          <ListBox x:Name="Filters" SelectionChanged="FilterChanged">
          <ListBoxItem Tag="{x:Static ui:LibraryFilter.All}" AutomationProperties.Name="{x:Static loc:Strings.AllDownloads}"><StackPanel Orientation="Horizontal" Spacing="9"><PathIcon Width="15" Height="15" Data="{StaticResource IconLibrary}" /><TextBlock Text="{x:Static loc:Strings.AllDownloads}" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="{x:Static ui:LibraryFilter.Active}" AutomationProperties.Name="{x:Static loc:Strings.ActiveTransfers}"><StackPanel Orientation="Horizontal" Spacing="9"><PathIcon Width="15" Height="15" Data="{StaticResource IconActive}" /><TextBlock Text="{x:Static loc:Strings.ActiveTransfers}" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="{x:Static ui:LibraryFilter.Finished}" AutomationProperties.Name="{x:Static loc:Strings.FinishedTransfers}"><StackPanel Orientation="Horizontal" Spacing="9"><PathIcon Width="15" Height="15" Data="{StaticResource IconFinished}" /><TextBlock Text="{x:Static loc:Strings.FinishedTransfers}" /></StackPanel></ListBoxItem>
          <ListBoxItem Tag="{x:Static ui:LibraryFilter.Incomplete}" AutomationProperties.Name="{x:Static loc:Strings.IncompleteTransfers}"><StackPanel Orientation="Horizontal" Spacing="9"><PathIcon Width="15" Height="15" Data="{StaticResource IconIncomplete}" /><TextBlock Text="{x:Static loc:Strings.IncompleteTransfers}" /></StackPanel></ListBoxItem>
          </ListBox>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,*">
        <Border x:Name="Editor" IsVisible="False" Classes="editor">
          <StackPanel Spacing="8" x:Name="Fields">
            <TextBlock Classes="section" Text="{x:Static loc:Strings.Heading}" />
            <Grid ColumnDefinitions="100,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="{x:Static loc:Strings.Url}" />
              <TextBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="SourceUrl" AutomationProperties.Name="{x:Static loc:Strings.Url}" PlaceholderText="{x:Static loc:Strings.UrlHint}" />
              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="{x:Static loc:Strings.Destination}" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="Destination" AutomationProperties.Name="{x:Static loc:Strings.Destination}" PlaceholderText="{x:Static loc:Strings.DestinationHint}" />
              <Button Grid.Row="1" Grid.Column="2" Content="{x:Static loc:Strings.Browse}" Click="BrowseClicked" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="Start" Classes="accent" Content="{x:Static loc:Strings.Start}" Click="StartClicked" />
              <Button Content="{x:Static loc:Strings.Dismiss}" Click="DismissClicked" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
          <Border Classes="columnHeader">
            <Grid ColumnDefinitions="2*,90,120,*" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{x:Static loc:Strings.FileName}" />
              <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.FileSize}" />
              <TextBlock Grid.Column="2" Text="{x:Static loc:Strings.TransferStatus}" />
              <TextBlock Grid.Column="3" Text="{x:Static loc:Strings.Source}" />
            </Grid>
          </Border>
          <ListBox Grid.Row="1" x:Name="Rows" SelectionChanged="RowChanged">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Margin" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="ui:DownloadRow">
                <Grid ColumnDefinitions="2*,90,120,*" ColumnSpacing="8">
                  <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Destination}" />
                  <TextBlock Grid.Column="1" Text="{Binding Size}" />
                  <TextBlock Grid.Column="2" Text="{Binding Status}" />
                  <TextBlock Grid.Column="3" Text="{Binding Host}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False" Opacity="0.68">
            <PathIcon Width="32" Height="32" Data="{StaticResource IconFile}" />
            <TextBlock Text="{x:Static loc:Strings.NoEntries}" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="3" Classes="footer">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <TextBlock x:Name="Status" Text="{x:Static loc:Strings.Ready}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <ProgressBar Grid.Column="1" x:Name="Activity" IsVisible="False" Width="65" Height="4" />
        <TextBlock Grid.Column="2" x:Name="Count" />
      </Grid>
    </Border>
  </Grid>
</Window>
