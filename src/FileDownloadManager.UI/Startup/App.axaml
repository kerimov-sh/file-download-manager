<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileDownloadManager.UI.Startup.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://FileDownloadManager.UI/Resources/Icons/DownloadIcons.axaml" />
        <ResourceInclude Source="avares://FileDownloadManager.UI/Resources/Themes/DesktopPalette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#94ADE0" RegionColor="#232730"
                               AltHigh="#232730" BaseHigh="#E3E8F0" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://FileDownloadManager.UI/Resources/Themes/DownloadForm.axaml" />
  </Application.Styles>
</Application>
