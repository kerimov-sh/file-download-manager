<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="WindowSurface">#232730</SolidColorBrush>
    <SolidColorBrush x:Key="PanelSurface">#272C36</SolidColorBrush>
    <SolidColorBrush x:Key="HeaderSurface">#2D333F</SolidColorBrush>
    <SolidColorBrush x:Key="GridRule">#343B47</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarAddBrush">#80BDAC</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarRetryBrush">#85B3DA</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarStopBrush">#D39A8A</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarStopAllBrush">#CDA384</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarRemoveBrush">#C59BBE</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarClearBrush">#BBA1CC</SolidColorBrush>
    <SolidColorBrush x:Key="ToolbarOptionsBrush">#AAA9D9</SolidColorBrush>
    <SolidColorBrush x:Key="CategoryIconBrush">#D0B679</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowSurface}" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.toolbar, Border.groupBar">
    <Setter Property="BorderBrush" Value="{DynamicResource GridRule}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.toolbar"><Setter Property="Padding" Value="9,5" /></Style>
  <Style Selector="Button.tool">
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="BorderBrush" Value="{DynamicResource GridRule}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="TextBlock.section"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Border.toolbar, Border.sidebar, Border.footer">
    <Setter Property="Background" Value="{DynamicResource PanelSurface}" />
  </Style>
  <Style Selector="Border.groupBar">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Background" Value="{DynamicResource PanelSurface}" />
  </Style>
  <Style Selector="TableViewColumnHeader">
    <Setter Property="Background" Value="{DynamicResource HeaderSurface}" />
  </Style>
  <Style Selector="Button.columnSort">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="TableViewCell">
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource GridRule}" />
  </Style>
  <Style Selector="TextBlock.groupTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.footer">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="BorderBrush" Value="{DynamicResource GridRule}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
</Styles>
